<%- include('partials/header', { title: title }) %>

<% if (listing.status === 'traded') { %>
  <div class="traded-banner">✅ This item has been traded and is no longer available.</div>
<% } else if (listing.status === 'removed') { %>
  <div class="traded-banner">This listing has been removed.</div>
<% } %>

<div class="detail">
  <div>
    <div class="gallery-main" id="gallery-main">
      <% if (photos.length) { %>
        <img id="main-photo" src="/uploads/<%= photos[0].filename %>" alt="<%= listing.title %>">
      <% } else { %>
        <span><%= CATEGORY_EMOJI[listing.category] || '📦' %></span>
      <% } %>
    </div>
    <% if (photos.length > 1) { %>
      <div class="gallery-thumbs">
        <% photos.forEach(function(p, i) { %>
          <img src="/uploads/<%= p.filename %>" alt="" class="gallery-thumb<%= i === 0 ? ' active' : '' %>" data-full="/uploads/<%= p.filename %>">
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="detail-info">
    <h1><%= listing.title %></h1>
    <div class="detail-meta">
      <span class="badge badge-<%= listing.condition %>"><%= listing.condition %></span>
      <span><%= listing.category %></span>
      <span>Listed by <strong><%= listing.owner_name %></strong></span>
      <span><%= fmtDate(listing.created_at) %></span>
    </div>
    <% if (listing.price_estimate_cents) { %>
      <div class="detail-price"><%= money(listing.price_estimate_cents) %> <span style="font-size:14px;font-weight:400;color:#5b6b78;">estimated value</span></div>
    <% } %>
    <div class="detail-desc"><%= listing.description %></div>

    <div class="detail-actions">
      <% if (listing.status === 'active') { %>
        <% if (isOwn) { %>
          <a class="btn btn-outline" href="/dashboard">Manage in dashboard</a>
          <span style="color:#5b6b78;font-size:14px;align-self:center;"><%= offerCount %> pending offer<%= offerCount === 1 ? '' : 's' %></span>
        <% } else if (member) { %>
          <% if (myPendingOffer) { %>
            <span class="badge badge-pending" style="font-size:14px;">You have a pending offer on this item</span>
            <a class="btn btn-outline" href="/dashboard">View in dashboard</a>
          <% } else { %>
            <a class="btn" href="/listings/<%= listing.id %>/offer">Make a trade offer</a>
          <% } %>
        <% } else { %>
          <a class="btn" href="/login?next=<%= encodeURIComponent('/listings/' + listing.id + '/offer') %>">Log in to make an offer</a>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
