# Valora production config — copy to .env and fill in.
PORT=3000
DB_PATH=./data/valora.db
UPLOAD_DIR=./data/uploads

# REQUIRED — 32+ random characters. Generate: openssl rand -hex 32
SESSION_SECRET=

# Owner seeding (one-time setup flow)
OWNER_EMAIL=
SETUP_TOKEN=

NODE_ENV=development

# Optional — Stripe webhook signing secret (enables signature verification)
STRIPE_WEBHOOK_SECRET=
